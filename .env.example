# Copy to .env. setup:local generates random local secrets. Never put secrets in VITE_*.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://nckh:CHANGE_ME@127.0.0.1:55432/nckh?schema=public
# For Supabase: direct/session connection for migrations; pooled URL for runtime.
MIGRATION_DATABASE_URL=postgresql://nckh:CHANGE_ME@127.0.0.1:55432/nckh?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=nckh-api
JWT_AUDIENCE=nckh-web
COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, protected scheduler endpoint; CLI jobs do not need this.
SCHEDULER_SECRET=
# Local demo seed only; set a strong unique password. Do not seed production.
DEMO_PASSWORD=
# Actual PostgreSQL bin directory, for backup/restore.
PG_BIN=.local/pgsql/bin
# First administrator on a new deployment only. Set via protected server env, then unset password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_CODE=administrator
